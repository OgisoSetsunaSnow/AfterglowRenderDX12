# ===== Visual Studio / MSBuild 构建产物 =====
# VS 中间目录与输出目录（仓库根就是工程根）
Afterglo.*/
x64/

# ===== 编译器/链接器产物 =====
*.obj
*.o
*.pdb
*.ilk
*.idb
*.iobj
*.ipdb
*.tlog
*.recipe
*.log

# ===== VS 用户本地配置 =====
.vs/
*.vcxproj.user
*.suo
*.user

# ===== CodeBuddy 工作笔记（私人会话记忆，不属于项目代码） =====
.codebuddy/

# ===== 运行/临时文件 =====
*.cache
*.png.tmp
Thumbs.db
Desktop.ini
run_out*.txt
run_err*.txt
imgui.ini

# ===== assimp 静态库（约 540MB，过大不入库，见 README"第三方依赖库"节自行下载） =====
vsbuild/Libraries/assimp-5.4.3/lib/*.lib

# ===== 本地音乐（版权/个人文件，不入库；仅保留说明文件） =====
vsbuild/Assets/Music/*
!vsbuild/Assets/Music/README.txt

# ===== 发行版打包产物（不入库；make_release.ps1 生成 Release_Package/ 和 zip） =====
Release_Package/
AfterglowRenderDX12_Release.zip

# ===== 备份与系统文件 =====
*.bak
*.orig
